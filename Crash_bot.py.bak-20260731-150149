def handler_securise(func):
    @wraps(func)
    async def wrapper(update: Update, context: ContextTypes.DEFAULT_TYPE):
        try:
            if not await controler_acces_client(update, context):
                return None
            return await func(update, context)
        except Exception as exc:
            logger.exception("Erreur dans %s", func.__name__, exc_info=exc)
            try:
                if update.callback_query:
                    await update.callback_query.answer("Une erreur est survenue. RÃ©essaie dans quelques secondes.", show_alert=False)
                elif update.effective_message:
                    await update.effective_message.reply_text("âš ï¸ Une erreur est survenue. RÃ©essaie dans quelques secondes.")
            except TelegramError:
                logger.exception("Impossible d'envoyer le message d'erreur Ã  l'utilisateur.")
            return None

    return wrapper


